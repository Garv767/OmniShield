# ==============================================================================
# OmniShield Backend Environment Configuration Template
# Copy this file to '.env' and fill in your keys for local development.
# ==============================================================================

# Database connection URL
# Defaults to local SQLite if left blank or commented out.
# For production PostgreSQL: postgresql://user:password@host:port/dbname
# DATABASE_URL=sqlite:///./fraud_detection.db

# Generative AI Compliance Reporter (LangChain API Keys)
# (Optional: If both are empty, the backend will automatically fall back
# to an offline rule-based report builder with zero extra costs).
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
